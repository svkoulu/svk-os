# iso/installer/Containerfile — the throwaway "installer image" Titanoboa squashfs's
# into a live-boot ISO. Built FROM the already-published (or locally-built) svk-os
# image; never pushed to GHCR. See iso/installer/build.sh for what it adds: Anaconda
# + BOTH role kickstarts (lab / staff, picked from the GRUB menu at boot), the
# offline flatpak bake, and the live-boot/iso.yaml plumbing the container-native ISO
# contract expects.
#
# Build with: podman build --cap-add sys_admin --security-opt label=disable
#   --build-arg BASE_IMAGE=<svk-os ref>
#   --build-arg IMAGE_REF=<real ghcr ref the installed system should track>
#   -f iso/installer/Containerfile <repo root>
#
# No `bootc container lint` here — this image never runs via bootc, it's a
# live-ISO source only.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG IMAGE_REF
# Interim placeholder password for the kickstart's baked `staff` login; blank falls
# back to the default in build.sh. The kickstart expires it at first login either
# way. Removed entirely once the USB provisioning config generates real accounts.
ARG STAFF_PASSWORD=""
# Interim placeholder password for the `admin` operator, set by the kickstart's
# %post (sysusers creates admin with a LOCKED password, which left every polkit
# auth_admin prompt at the GUI unanswerable). Blank falls back to the default in
# build.sh. Not expired at first login — see the note in build.sh. Removed
# entirely once the USB provisioning config issues per-machine credentials.
ARG ADMIN_PASSWORD=""
# BASE_IMAGE's own org.opencontainers.image.version (e.g. stable-1-20260719),
# read by iso/build-iso.sh before this build. Blank for a local image with no
# version label. Used only to name the GRUB boot-menu entry.
ARG VERSION
# NOTE: no LUKS passphrase build-arg — the disk-encryption passphrase is generated
# per-install in the kickstart's %pre (iso/installer/build.sh), so nothing secret is
# baked into this image.
# Full git commit SHA of the svk repo checkout that ran iso/build-iso.sh — NOT
# necessarily the same commit that built BASE_IMAGE (you can rebuild an ISO with
# newer iso/ scripts against an already-published older image). Stamped into the
# live environment as iso-build-info.json so a captured log bundle from a real
# install can be correlated with the exact iso/ script version that produced it.
ARG ISO_GIT_SHA=""

COPY flatpaks/ /tmp/flatpaks/
COPY iso/installer/build.sh /tmp/build.sh
# iso/.local-image/ holds an OCI archive of the locally-built svk-os for a
# `iso/build-iso.sh local` run, and is EMPTY for a ghcr build (build.sh fetches
# from the registry instead). Bind-mounted rather than COPY'd: the archive is the
# size of the whole image and must not become a layer of this one.
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=bind,source=iso/.local-image,target=/tmp/local-image \
    IMAGE_REF="${IMAGE_REF}" VERSION="${VERSION}" \
    STAFF_PASSWORD="${STAFF_PASSWORD}" ADMIN_PASSWORD="${ADMIN_PASSWORD}" \
    ISO_GIT_SHA="${ISO_GIT_SHA}" \
    bash /tmp/build.sh \
    && rm -rf /tmp/build.sh /tmp/flatpaks
