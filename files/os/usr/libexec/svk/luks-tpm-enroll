#!/usr/bin/bash
# luks-tpm-enroll — first boot after an ISO install. Turns the freshly-installed
# LUKS root (created by Anaconda with a throwaway "bootstrap" passphrase, see
# iso/installer/build.sh) into a disk that:
#
#   1. auto-unlocks via the TPM2, so students/staff never type a passphrase; and
#   2. has a UNIQUE per-machine recovery key as the only human fallback.
#
# The recovery key is printed ONCE on the console (tty1, with a QR code) for the
# admin to photograph during provisioning — it can never be retrieved again. The
# bootstrap passphrase slot is then wiped, so nothing that ships in the ISO can
# unlock a deployed machine.
#
# Ordering note: the TPM is normally pre-enrolled at install time (svk-luks-tpm.ks
# %post), so the FIRST boot already auto-unlocks — this service then just adds the
# recovery key and wipes the bootstrap slot. If the TPM couldn't be enrolled at
# install (no TPM, or a PCR mismatch), the initramfs instead prompts for the
# per-build bootstrap passphrase (printed by iso/build-iso.sh); after the admin
# types it once, this service enrolls the TPM as a fallback.
#
# Guarded by /etc/svk/luks-bootstrap (dropped by the kickstart): absent on
# non-encrypted (dev/local) installs and on every boot after the first, so the
# unit's ConditionPathExists makes this a cheap no-op thereafter.
#
# Three outcomes, decided by /usr/libexec/svk/tpm2-capable rather than by letting
# the enrollment fail:
#
#   TPM usable, enrolled      -> wipe the bootstrap slot; disk auto-unlocks, the
#                                recovery key is the backup. Service disabled.
#   TPM usable, enroll failed -> unexpected: keep the bootstrap slot, retry next
#                                boot.
#   TPM not usable            -> permanent (no chip, or a chip too old); retrying
#                                can never succeed, so stop and tell the operator
#                                the recovery key is now the every-boot secret.
#
# NOTE (validate on real hardware): TPM2 auto-unlock relies on systemd-cryptsetup
# honouring `tpm2-device=auto` in /etc/crypttab. If a machine still prompts for the
# recovery key every boot, the initramfs isn't reading this crypttab — the fix is
# to add `rd.luks.options=tpm2-device=auto` to the kernel args. The recovery key
# shown here always works regardless.
set -euo pipefail

BOOTSTRAP=/etc/svk/luks-bootstrap
STAMP=/var/lib/svk/.luks-tpm-enrolled
SERVICE=svk-luks-tpm-enroll.service

log()  { echo "luks-tpm-enroll: $*"; }
done_disable() { systemctl disable "$SERVICE" >/dev/null 2>&1 || true; }

# Secure Boot state, reported only in the no-usable-TPM warning below (tik does the
# same via `mokutil --sb-state`; svk doesn't ship mokutil, and the EFI variable is
# the same source of truth). Byte 5 of the variable — after the 4-byte attribute
# prefix — is 1 when Secure Boot is on.
SB_VAR=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
sb_state() {
    [ -r "$SB_VAR" ] || { echo unknown; return; }
    case "$(od -An -tu1 -j4 -N1 "$SB_VAR" 2>/dev/null | tr -d '[:space:]')" in
        1) echo enabled ;;
        0) echo disabled ;;
        *) echo unknown ;;
    esac
}

# No bootstrap file => non-encrypted install or already enrolled: nothing to do.
if [ ! -f "$BOOTSTRAP" ]; then
    log "no ${BOOTSTRAP}; nothing to enroll."
    done_disable
    exit 0
fi

# Locate the LUKS backing device from the first real crypttab line. Anaconda writes
#   luks-<uuid>  UUID=<uuid>  none  <options>
crypt_line="$(awk '!/^#/ && NF {print; exit}' /etc/crypttab || true)"
luks_uuid="$(awk '{print $2}' <<<"$crypt_line" | sed 's/^UUID=//')"
dev="/dev/disk/by-uuid/${luks_uuid}"
if [ -z "$luks_uuid" ] || [ ! -e "$dev" ]; then
    log "no LUKS device found in /etc/crypttab; skipping (assuming unencrypted)."
    rm -f "$BOOTSTRAP"
    done_disable
    exit 0
fi

pass="$(cat "$BOOTSTRAP")"

# 1. Per-machine recovery key FIRST, so a human fallback exists before we touch
#    anything else. systemd-cryptenroll prints the key to stdout.
log "enrolling a recovery key..."
recovery="$(PASSWORD="$pass" systemd-cryptenroll --recovery-key "$dev")"

# 2. TPM2 for automatic unlock. Normally the install-time %post already enrolled it
#    — detect that so we don't stack a second slot, and only enroll here as the
#    fallback (no TPM at install, or it failed).
#
#    PCR 7 ONLY (Secure Boot state and keys). This is deliberate — do NOT "harden"
#    it by binding more PCRs. PCR 0/1 change on every firmware update or BIOS
#    toggle; 4/5/9 change on every bootloader or kernel/initrd update; each one is
#    another way for a machine to strand itself at a recovery prompt after a routine
#    update. On mixed school hardware that costs more than it buys, so svk's policy
#    is deliberately looser than Aeon's 4,5,7,9. See §1 of
#    tasks/done/20260726-2014-fde-tpm-and-install-path.md.
tpm_ok=0
tpm_capable=1          # until the probe says otherwise
tpm_reason=""
if systemd-cryptenroll "$dev" 2>/dev/null | grep -qiw tpm2; then
    tpm_ok=1
    log "TPM2 already enrolled (install-time); keeping it."
elif tpm_reason="$(/usr/libexec/svk/tpm2-capable)"; then
    # Probe first: an inadequate TPM is worth naming, not discovering by failure.
    log "TPM2 probe: ${tpm_reason}"
    if PASSWORD="$pass" systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 "$dev"; then
        tpm_ok=1
        log "TPM2 enrolled."
    else
        log "WARNING: TPM2 enrollment failed on a capable TPM — will retry on next boot."
    fi
else
    tpm_capable=0
    # Defensive: the probe ships alongside this script, but if it were ever missing
    # the reason would be empty and the banner below would say nothing useful.
    tpm_reason="${tpm_reason:-tpm2-capable probe did not report a reason}"
    log "WARNING: TPM2 auto-unlock not possible: ${tpm_reason}"
fi

# 3. Ask systemd-cryptsetup to try the TPM at boot: add tpm2-device=auto to the
#    crypttab options field (field 4; 'none' keyfile stays in field 3).
if [ "$tpm_ok" = 1 ] && ! grep -q 'tpm2-device=' /etc/crypttab; then
    awk 'BEGIN{OFS=" "}
         /^#/ || NF==0 {print; next}
         {opts=(NF>=4 ? $4 : "");
          opts=(opts=="" ? "tpm2-device=auto" : "tpm2-device=auto," opts);
          print $1,$2,$3,opts}' /etc/crypttab >/etc/crypttab.svk-new \
        && mv /etc/crypttab.svk-new /etc/crypttab
fi

# 4. Show the recovery key on the console and wait for the admin to record it.
qr="$(qrencode -t ANSIUTF8 <<<"$recovery" 2>/dev/null || true)"
cat <<BANNER

################################################################################
#                          SVK DISK RECOVERY KEY                               #
#                                                                              #
#  Record this key now. It is shown ONCE and CANNOT be retrieved later.        #
#  It is the ONLY fallback if the TPM ever stops unlocking this disk.          #
################################################################################

    Machine : $(hostnamectl --static 2>/dev/null || hostname)
    Disk    : ${dev}

    RECOVERY KEY:

        ${recovery}

${qr}

################################################################################
BANNER
if [ "$tpm_ok" = 1 ]; then
    echo "  TPM2 auto-unlock: ENROLLED (this disk should unlock without a prompt)."
elif [ "$tpm_capable" = 0 ]; then
    # Permanent fallback. Say why, and say what it means for daily use — this is the
    # case that used to look like "the machine mysteriously asks for a passphrase".
    echo "  TPM2 auto-unlock: NOT POSSIBLE on this machine."
    echo "    Reason: ${tpm_reason}."
    echo "  This disk will ask for the RECOVERY KEY ABOVE ON EVERY BOOT. Record it"
    echo "  durably and label the machine — it is the only way in."
    sb="$(sb_state)"
    echo "  Secure Boot: ${sb}."
    if [ "$sb" = disabled ]; then
        echo "  Enabling Secure Boot in firmware is strongly recommended on a machine"
        echo "  that cannot bind its disk key to a TPM."
    fi
else
    echo "  TPM2 auto-unlock: FAILED — you will be asked for this key each boot until"
    echo "  it succeeds (it retries on the next boot). Keep the key safe."
fi
echo
# Block (with a generous cap) so provisioning can't race past the key. If nobody
# is present the machine still proceeds after the timeout rather than hanging.
# Whether a human actually acknowledged is load-bearing in the no-TPM case below.
acked=1
read -r -t 900 -p "  Press ENTER once you have recorded the recovery key... " _ || {
    acked=0
    log "no acknowledgement within timeout; continuing."
}

# 5. Wipe the install-time bootstrap passphrase so it no longer unlocks anything,
#    and converge — this service should stay enabled only if a retry could help.
#
#    `--wipe-slot=password` removes password slots only; systemd records the
#    recovery key as its own `recovery` slot type, so the key printed above
#    survives the wipe. That distinction is what makes the no-TPM branch safe.
wipe_bootstrap() {
    log "wiping the bootstrap passphrase slot..."
    PASSWORD="$pass" systemd-cryptenroll --wipe-slot=password "$dev" || \
        log "WARNING: could not wipe the bootstrap slot; do so manually."
    rm -f "$BOOTSTRAP"
    mkdir -p "$(dirname "$STAMP")"
    : >"$STAMP"
}

if [ "$tpm_ok" = 1 ]; then
    wipe_bootstrap
    done_disable
    log "done."
elif [ "$tpm_capable" = 0 ]; then
    # No usable TPM: retrying can never succeed, and re-running would only mint a
    # second recovery key. Stop either way.
    #
    # The wipe is gated on a human acknowledgement here, because unlike the branch
    # above there is no TPM to fall back on: wiping would leave the recovery key as
    # the disk's ONLY secret, and on an unattended install nobody saw it. Keeping a
    # per-install passphrase slot on such a machine is the lesser evil — it is
    # unique to this install and never shipped in the ISO.
    if [ "$acked" = 1 ]; then
        wipe_bootstrap
        log "no usable TPM; the recovery key is now this disk's only unlock secret."
    else
        log "WARNING: no usable TPM, and the recovery key was never acknowledged."
        log "         Keeping the bootstrap passphrase slot so this disk stays openable."
        log "         The passphrase is in ${BOOTSTRAP}. Once the recovery key is"
        log "         recorded, wipe the slot and the file:"
        log "           systemd-cryptenroll --wipe-slot=password ${dev}"
        log "           rm -f ${BOOTSTRAP}"
    fi
    done_disable
else
    # Capable TPM, failed enrollment. Leave BOOTSTRAP in place; the service stays
    # enabled to retry next boot.
    log "TPM not enrolled; leaving bootstrap in place to retry."
fi
