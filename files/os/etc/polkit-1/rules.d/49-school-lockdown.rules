// Kiosk polkit lockdown. Deny the `opilas` account any privileged action:
// no package installs, no mount/format of disks, no changing system settings,
// no color-manager prompts, etc.
//
// This ships in EVERY machine's image and is what makes the single-image collapse
// safe: the rule gates on `subject.user == "opilas"`, so it is inert — present but
// never matching — on a machine where that account was never created. Staff and
// admin accounts are unaffected on the very same image.
//
// polkit evaluates rules files in lexical order and the first rule to return a
// value wins; 49- keeps us ahead of most distro defaults while leaving room (50+)
// for later overrides. It also means this deny is evaluated BEFORE the staff
// grant in 50-svk-staff-flatpak.rules — belt and braces, since opilas is not in
// the svk-staff group that grant matches on anyway.
//
// Deliberately NOT denied, so the defaults (generally "yes"/"auth_self" for
// the active local user) apply:
//   - org.freedesktop.login1.*        -> students must be able to shut down /
//     restart the laptop from the GNOME power menu.
//
// NetworkManager.settings.* IS now denied (below): the machine is locked to
// exactly one baked Wi-Fi profile (files/student/etc/NetworkManager/
// system-connections/svk-student-wifi.nmconnection), so opilas must not be
// able to add, edit, or remove connection profiles — there should never be a
// second network to join. The enable/disable actions are denied too so the
// Quick Settings Wi-Fi toggle / "Disconnect" no-ops instead of dropping the
// one connection that exists.

polkit.addRule(function(action, subject) {
    if (subject.user == "opilas") {
        // Blanket-deny the sensitive action families a kiosk should never allow.
        if (action.id.indexOf("org.freedesktop.packagekit.")   == 0 ||
            action.id.indexOf("org.freedesktop.Flatpak.")       == 0 ||
            action.id.indexOf("org.freedesktop.udisks2.")       == 0 ||
            action.id.indexOf("org.freedesktop.systemd1.")       == 0 ||
            action.id.indexOf("org.rpm-ostree.")                 == 0 ||
            action.id.indexOf("org.freedesktop.hostname1.")      == 0 ||
            action.id.indexOf("org.freedesktop.NetworkManager.settings.") == 0 ||
            action.id == "org.freedesktop.NetworkManager.enable-disable-wifi" ||
            action.id == "org.freedesktop.NetworkManager.enable-disable-network" ||
            action.id == "org.freedesktop.NetworkManager.network-control") {
            return polkit.Result.NO;
        }
    }
});
