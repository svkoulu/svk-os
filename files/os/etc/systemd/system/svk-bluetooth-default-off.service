# Kiosk default: Bluetooth starts blocked on every boot. Students can still
# switch it on from Quick Settings for the session (rfkill soft-block isn't
# polkit-gated); this unit just re-blocks it on the next boot so one student's
# choice doesn't stick for the next, and the lab default stays "off".
[Unit]
Description=svk: block Bluetooth radio by default (kiosk)
Before=display-manager.service

[Service]
Type=oneshot
# Kiosk-only behaviour on a single fleet image: gate it on the kiosk account
# existing, so a staff laptop (where Bluetooth mice/headsets are normal kit)
# never gets its radio blocked at boot. getent exits 2 if opilas is absent, which
# systemd treats as "skip", not "fail".
ExecCondition=/usr/bin/getent passwd opilas
ExecStart=/usr/sbin/rfkill block bluetooth

[Install]
WantedBy=multi-user.target
