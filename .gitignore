# Never commit the cosign PRIVATE key (only cosign.pub belongs in git).
cosign.key
*.key

# Local ISO / build output.
output/
*.iso
iso/.build/
# OCI archive of the locally-built image, staged for the installer's nested copy
# by `iso/build-iso.sh local` and deleted again when it exits. Image-sized.
iso/.local-image/
# Per-build provenance sidecar written next to each ISO (iso/build-iso.sh). Not a
# secret, but a build output — belongs in the CI artifact, not in git.
iso/*.build-info.json

# The real lab Wi-Fi connection profile holds a plaintext PSK — it stays local,
# never in git. Only the .example template (with placeholder SSID/PSK) is tracked.
files/os/etc/NetworkManager/system-connections/*.nmconnection
